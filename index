                price: 8990,
                image: "https://images.unsplash.com/photo-1512428559087-560fa5ceab42?auto=format&fit=crop&w=600&q=80",
                description: "Macetero de barro horneado a alta temperatura con plato de drenaje incluido. Tono beige terroso."
            },
            {
                id: 5,
                name: "Sedum Morganianum (Burrito)",
                category: "suculentas",
                categoryLabel: "Suculenta Colgante",
                price: 6490,
                image: "https://images.unsplash.com/photo-1459411552884-841db9b3cc2a?auto=format&fit=crop&w=600&q=80",
                description: "Variedad de hermosas tallos colgantes repletos de hojas cilíndricas carnosas verde azulado."
            },
            {
                id: 6,
                name: "Terrario de Cristal Minimalista",
                category: "arreglos",
                categoryLabel: "Composición Regalo",
                price: 19990,
                image: "https://images.unsplash.com/photo-1463936575829-25148e1db1b8?auto=format&fit=crop&w=600&q=80",
                description: "Ecosistema semi-abierto de vidrio con suculentas variadas y capas decorativas de piedras volcánicas."
            },
            {
                id: 7,
                name: "Sustrato Premium Suculentas 3L",
                category: "maceteros",
                categoryLabel: "Accesorio de Cuidado",
                price: 4500,
                image: "https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=600&q=80",
                description: "Mezcla ideal de pómex, humus de lombriz y corteza que previene la pudrición radicular."
            },
            {
                id: 8,
                name: "Crassula Ovata (Planta de Jade)",
                category: "suculentas",
                categoryLabel: "Suculenta Arbustiva",
                price: 7990,
                image: "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=600&q=80",
                description: "Clásica planta del dinero y la abundancia, con hojas gruesas y apariencia miniatura tipo bonsái."
            }
        ];

        // ESTADO DEL CARRITO
        let cart = [];

        // INITIALIZATION
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            renderProducts(products);
            setupMobileMenu();
        });

        // RENDERIZAR PRODUCTOS
        function renderProducts(items) {
            const container = document.getElementById('productsGrid');
            container.innerHTML = '';

            items.forEach(product => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-xl overflow-hidden border border-arena-300 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group';
                card.innerHTML = `
                    <div>
                        <div class="relative overflow-hidden h-60 bg-arena-100">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 demo-badge text-[10px] font-bold px-2.5 py-1 rounded-full text-bosque-900 uppercase tracking-wider">
                                Demostración
                            </span>
                        </div>
                        <div class="p-5">
                            <span class="text-[10px] uppercase tracking-widest font-bold text-salvia-600 block mb-1">${product.categoryLabel}</span>
                            <h3 class="font-serif text-xl text-bosque-900 group-hover:text-salvia-600 transition-colors">${product.name}</h3>
                            <p class="text-xs text-gray-500 mt-2 line-clamp-2 leading-relaxed">${product.description}</p>
                        </div>
                    </div>
                    <div class="p-5 pt-0 border-t border-gray-50 flex items-center justify-between mt-4">
                        <div>
                            <span class="text-[10px] text-gray-400 block uppercase">Precio</span>
                            <span class="font-serif text-xl font-semibold text-bosque-900">$${product.price.toLocaleString('es-CL')} <span class="text-[10px] font-sans font-normal">CLP</span></span>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="openProductModal(${product.id})" class="p-2 border border-arena-300 rounded-lg hover:bg-arena-100 text-gray-600 transition-colors" title="Vista Rápida">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button onclick="addToCart(${product.id}, '${product.name}', ${product.price}, '${product.image}')" class="p-2 bg-salvia-600 hover:bg-salvia-700 text-white rounded-lg transition-colors flex items-center gap-1 text-xs font-medium px-3">
                                <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                                <span class="hidden sm:inline">Agregar</span>
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        // FILTRO DE CATEGORÍAS
        function filterCategory(cat) {
            const buttons = document.querySelectorAll('.cat-filter');
            buttons.forEach(btn => {
                if (btn.getAttribute('data-cat') === cat) {
                    btn.className = 'cat-filter active px-4 py-2 rounded-full border border-salvia-500 bg-salvia-600 text-white font-medium transition-all';
                } else {
                    btn.className = 'cat-filter px-4 py-2 rounded-full border border-arena-300 bg-white text-gray-700 hover:border-salvia-400 transition-all';
                }
            });

            if (cat === 'todos') {
                renderProducts(products);
            } else {
                const filtered = products.filter(p => p.category === cat);
                renderProducts(filtered);
            }
        }

        // CARRITO LÓGICA
        function addToCart(id, name, price, image) {
            const existingIndex = cart.findIndex(item => item.id === id);
            if (existingIndex > -1) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push({ id, name, price, image, quantity: 1 });
            }
            updateCartUI();
            toggleCart(true);
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartUI();
        }

        function updateCartUI() {
            const countEl = document.getElementById('cartCount');
            const container = document.getElementById('cartItemsContainer');
            const totalEl = document.getElementById('cartTotal');

            const totalItems = cart.reduce((acc, item) => acc + item.quantity, 0);
            countEl.innerText = totalItems;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-gray-400 space-y-3">
                        <i data-lucide="shopping-bag" class="w-12 h-12 mx-auto text-arena-300"></i>
                        <p class="text-sm font-light">Tu carrito está vacío.</p>
                    </div>
                `;
                totalEl.innerText = '$0 CLP';
                lucide.createIcons();
                return;
            }

            container.innerHTML = '';
            let total = 0;

            cart.forEach(item => {
                total += item.price * item.quantity;
                const div = document.createElement('div');
                div.className = 'flex items-center justify-between bg-white p-3 rounded-lg border border-arena-300';
                div.innerHTML = `
                    <div class="flex items-center gap-3">
                        <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded-md object-cover">
                        <div>
                            <h4 class="text-xs font-semibold text-bosque-900">${item.name}</h4>
                            <span class="text-xs text-salvia-600 font-medium">$${item.price.toLocaleString('es-CL')} CLP x ${item.quantity}</span>
                        </div>
                    </div>
                    <button onclick="removeFromCart(${item.id})" class="text-gray-400 hover:text-red-500 p-1">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                `;
                container.appendChild(div);
            });

            totalEl.innerText = `$${total.toLocaleString('es-CL')} CLP`;
            lucide.createIcons();
        }

        function toggleCart(forceOpen = false) {
            const drawer = document.getElementById('cartDrawer');
            if (forceOpen || drawer.classList.contains('hidden')) {
                drawer.classList.remove('hidden');
            } else {
                drawer.classList.add('hidden');
            }
        }

        function checkoutDemo() {
            if (cart.length === 0) {
                alert('El carrito está vacío. Agrega productos demostrativos.');
                return;
            }
            alert('🛍️ MODO DEMOSTRACIÓN: La pasarela de pago real Webpay / Transferencia se habilitará al vincular inventario y tienda oficial.');
        }

        // BÚSQUEDA INTERACTIVA
        function toggleSearch() {
            const modal = document.getElementById('searchModal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
                document.getElementById('searchInput').focus();
            }
        }

        document.getElementById('searchBtn').addEventListener('click', toggleSearch);

        function handleSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const resultsContainer = document.getElementById('searchResults');
            resultsContainer.innerHTML = '';

            if (query.length < 2) return;

            const matches = products.filter(p => p.name.toLowerCase().includes(query) || p.description.toLowerCase().includes(query));

            if (matches.length === 0) {
                resultsContainer.innerHTML = '<p class="text-xs text-gray-500 p-2">No se encontraron productos relacionados.</p>';
                return;
            }

            matches.forEach(item => {
                const div = document.createElement('div');
                div.className = 'p-3 hover:bg-arena-100 rounded-lg cursor-pointer flex items-center justify-between transition-colors';
                div.onclick = () => {
                    toggleSearch();
                    openProductModal(item.id);
                };
                div.innerHTML = `
                    <div class="flex items-center gap-3">
                        <img src="${item.image}" class="w-10 h-10 rounded object-cover">
                        <div>
                            <p class="text-xs font-semibold text-bosque-900">${item.name}</p>
                            <span class="text-[10px] text-gray-500">$${item.price.toLocaleString('es-CL')} CLP</span>
                        </div>
                    </div>
                    <span class="text-xs text-salvia-600 font-medium">Ver</span>
                `;
                resultsContainer.appendChild(div);
            });
        }

        // MODAL VISTA DETALLE
        function openProductModal(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            document.getElementById('modalProductImg').src = product.image;
            document.getElementById('modalProductCat').innerText = product.categoryLabel;
            document.getElementById('modalProductTitle').innerText = product.name;
            document.getElementById('modalProductDesc').innerText = product.description;
            document.getElementById('modalProductPrice').innerText = `$${product.price.toLocaleString('es-CL')} CLP`;
            
            const btn = document.getElementById('modalProductBtn');
            btn.onclick = () => {
                addToCart(product.id, product.name, product.price, product.image);
                closeProductModal();
            };

            document.getElementById('productModal').classList.remove('hidden');
        }

        function closeProductModal() {
            document.getElementById('productModal').classList.add('hidden');
        }

        // ACORDEÓN FAQ
        function toggleFaq(index) {
            const content = document.getElementById(`faqContent-${index}`);
            const icon = document.getElementById(`faqIcon-${index}`);
            
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                content.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
        }

        // MENÚ MÓVIL
        function setupMobileMenu() {
            const btn = document.getElementById('mobileMenuBtn');
            const menu = document.getElementById('mobileMenu');
            const links = document.querySelectorAll('.mobile-link');

            btn.addEventListener('click', () => {
                menu.classList.toggle('hidden');
            });

            links.forEach(link => {
                link.addEventListener('click', () => {
                    menu.classList.add('hidden');
                });
            });
        }

        // FORMULARIOS DEMOSTRATIVOS
        function handleNewsletter(e) {
            e.preventDefault();
            const msg = document.getElementById('newsletterMsg');
            msg.classList.remove('hidden');
            e.target.reset();
            setTimeout(() => msg.classList.add('hidden'), 4000);
        }

        function handleContact(e) {
            e.preventDefault();
            const msg = document.getElementById('contactMsg');
            msg.classList.remove('hidden');
            e.target.reset();
            setTimeout(() => msg.classList.add('hidden'), 5000);
        }

        function openGuideModal() {
            alert("📚 GUÍA DIGITAL DE CUIDADOS:\n\n1. Riego: Esperar a que la tierra esté 100% seca.\n2. Luz: Filtrada y abundante.\n3. Drenaje: Maceteros siempre con orificio en la base.\n4. Reproducción: Retira una hoja sana desde el tallo y déjala cicatrizar 3 días antes de ponerla sobre sustrato húmedo.");
        }

        function openAdvisoryModal() {
            alert("🌿 ASESORÍAS PERSONALIZADAS:\n\nPuedes solicitar tu evaluación botánica llenando nuestro formulario de contacto en el área inferior. Nos comunicaremos para agendar tu reunión virtual o presencial.");
        }

        function showNotice(text) {
            alert("Información Legal / Términos: " + text);
        }
    </script>
